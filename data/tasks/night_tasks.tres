[gd_resource type="Resource" script_class="TaskDatabase" format=3 uid="uid://5elfkpuxfk5n"]

[ext_resource type="Script" uid="uid://cwswsvw8pajjl" path="res://scripts/resources/task_database.gd" id="1_db"]
[ext_resource type="Script" uid="uid://bydolre5rr267" path="res://scripts/resources/task_data.gd" id="2_task"]

[sub_resource type="Resource" id="T_lights"]
script = ExtResource("2_task")
id = &"keep_lights_on"
text = "Keep the reception lights on."
is_rule = true

[sub_resource type="Resource" id="T_phone"]
script = ExtResource("2_task")
id = &"answer_phone"
text = "Answer the telephone."

[sub_resource type="Resource" id="T_occupied"]
script = ExtResource("2_task")
id = &"no_occupied_rooms"
text = "Do not assign occupied rooms."
is_rule = true

[sub_resource type="Resource" id="T_room13"]
script = ExtResource("2_task")
id = &"room13_unavailable"
text = "If someone asks for Room 13, tell them it is unavailable."
is_rule = true

[sub_resource type="Resource" id="T_door"]
script = ExtResource("2_task")
id = &"no_door_after_midnight"
text = "Never open the entrance door after midnight unless you recognize the guest."
is_rule = true

[sub_resource type="Resource" id="T_checkin"]
script = ExtResource("2_task")
id = &"check_in_guest"
text = "Check in the guest at the desk."

[sub_resource type="Resource" id="T_register"]
script = ExtResource("2_task")
id = &"read_register"
text = "Check the guest register."

[resource]
script = ExtResource("1_db")
tasks = Array[ExtResource("2_task")]([SubResource("T_lights"), SubResource("T_phone"), SubResource("T_occupied"), SubResource("T_room13"), SubResource("T_door"), SubResource("T_checkin"), SubResource("T_register")])
note_title = "NIGHT SHIFT INSTRUCTIONS"
note_text = "1. Keep the reception lights on.
2. Answer the telephone.
3. Do not assign occupied rooms.
4. If someone asks for Room 13, tell them it is unavailable.
5. Never open the entrance door after midnight unless you recognize the guest."
