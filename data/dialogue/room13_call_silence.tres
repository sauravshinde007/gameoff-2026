[gd_resource type="Resource" script_class="DialogueData" format=3]

[ext_resource type="Script" path="res://scripts/resources/dialogue_data.gd" id="1_data"]
[ext_resource type="Script" path="res://scripts/resources/dialogue_line.gd" id="2_line"]

[sub_resource type="Resource" id="L1"]
script = ExtResource("2_line")
speaker = "You"
text = "Front desk. Hello?"

[sub_resource type="Resource" id="L2"]
script = ExtResource("2_line")
speaker = ""
text = "...static..."

[sub_resource type="Resource" id="L3"]
script = ExtResource("2_line")
speaker = ""
text = "*The line goes dead.*"

[resource]
script = ExtResource("1_data")
id = &"room13_call_silence"
loop_sfx = &"call_static"
lines = Array[ExtResource("2_line")]([SubResource("L1"), SubResource("L2"), SubResource("L3")])
